PORT=3000
# Compose constructs DATABASE_URL from these values. Use a URL-safe password.
POSTGRES_USER=auth_app
POSTGRES_DB=auth_service
POSTGRES_PASSWORD=
# Required for host-native development; Compose overrides it with its db host.
DATABASE_URL=
# Generate each secret separately: openssl rand -hex 32
JWT_SECRET=
REDIS_HOST=redis
REDIS_PORT=6379
# Optional managed connection URL; omit entirely when using REDIS_HOST/PORT.
# REDIS_URL=redis://private-host:6379
# Safe public preview: blocks signup/login/refresh/logout with 403.
DEMO_READ_ONLY=false
NODE_ENV=development

# CORS controls
ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_NO_ORIGIN=true
# Empty means no proxy is trusted. Set only your hosting proxy's IP/CIDRs.
TRUST_PROXY=

# Docs controls
DOCS_ENABLED=true
DOCS_VISIBILITY=public
# Required (32+ characters) only when DOCS_VISIBILITY=private.
# Send through X-Docs-Key, never a URL query parameter.
DOCS_ACCESS_TOKEN=

# Demo controls
DEMO_MODE=false
ENABLE_DEMO_ROUTES=false
# These legacy flags cannot enable any admin seed endpoint.