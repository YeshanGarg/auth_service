{
  "name": "auth-service-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "check": "npm run build && npm test",
    "start": "node dist/index.js",
    "start:neon": "node scripts/neon.mjs start",
    "dev": "npm run build && nodemon dist/index.js",
    "prisma:migrate": "dotenv npx prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "RUN_SESSION_INTEGRATION=true RUN_REDIS_INTEGRATION=true vitest run tests/session.integration.test.ts tests/rateLimit.integration.test.ts",
    "test:coverage": "RUN_SESSION_INTEGRATION=true RUN_REDIS_INTEGRATION=true vitest run --coverage",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:neon": "node scripts/neon.mjs migrate",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "24.19.2",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.0",
    "nodemon": "^3.1.11",
    "prisma": "7.10.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.5"
  }
}
